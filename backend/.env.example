# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit it.

# Supabase — get from your project settings > API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Groq — get from console.groq.com (free tier available)
GROQ_API_KEY=gsk_your-key-here

# CORS — set to your GitHub Pages URL in production
# Local dev: http://localhost:5500 (Live Server) or http://127.0.0.1:5500
CORS_ORIGIN=http://localhost:5500

# Environment
ENVIRONMENT=development
